          ["K3sAutoscaler", "WorkerMemory", "Cluster", "k3s-cluster", {"stat": "Average"}]
        ],
        "view": "timeSeries",
        "region": "ap-southeast-1",
        "period": 60,
        "yAxis": {"left": {"min": 0, "max": 100}}
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Ready Nodes",
