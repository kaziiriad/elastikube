{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# K3s Cluster Monitoring Dashboard\n**Cluster:** production-k3s | **Region:** ap-southeast-1\n\nMetrics from Lambda autoscaler, EventBridge rules, and DynamoDB state\n\n[Prometheus UI](http://MASTER_IP:30900) | [EC2 Instances](https://console.aws.amazon.com/ec2) | [Lambda Console](https://console.aws.amazon.com/lambda)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Worker Node CPU %",
        "metrics": [
          ["K3sAutoscaler", "WorkerCPU", "Cluster", "k3s-cluster", {"stat": "Average"}]
        ],
        "view": "timeSeries",
        "region": "ap-southeast-1",
        "period": 60,
        "yAxis": {"left": {"min": 0, "max": 100}}
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Worker Node Memory %",
