    {
      "type": "log",
      "x": 0,
      "y": 38,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Lambda Logs (Errors & Warnings)",
        "query": "SOURCE '/aws/lambda/k3s-autoscaler'\n| fields @timestamp, @message\n| filter @message like /ERROR|WARN|error|warn|fail|Fail/\n| sort @timestamp desc\n| limit 20",
        "region": "ap-southeast-1"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 38,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Decision Lambda Logs (Scaling)",
        "query": "SOURCE '/aws/lambda/k3s-autoscaler'\n| fields @timestamp, @message\n| filter @message like /Decision:|Scaling|scale|Scale/\n| sort @timestamp desc\n| limit 20",
        "region": "ap-southeast-1"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 44,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Scale-Up Lambda Logs",
        "query": "SOURCE '/aws/lambda/k3s-autoscaler-scale-up'\n| fields @timestamp, @message\n| sort @timestamp desc\n| limit 30",
        "region": "ap-southeast-1"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 44,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Scale-Down Lambda Logs",
        "query": "SOURCE '/aws/lambda/k3s-autoscaler-scale-down'\n| fields @timestamp, @message\n| sort @timestamp desc\n| limit 30",
        "region": "ap-southeast-1"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 50,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "All Lambda Logs (Recent)",
        "query": "fields @timestamp, @logStream, @message\n| filter @logStream like /k3s|scale/\n| sort @timestamp desc\n| limit 50",
        "region": "ap-southeast-1"
      }
    }
  ]
