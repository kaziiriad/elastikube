    "deployment_user_permissions": {
      "note": "Deployment user (k3s-temp-user) has scoped administrative access for infrastructure provisioning",
      "restrictions": [
        "IAM actions scoped to k3s-* prefixed roles and instance profiles only",
        "S3 actions scoped to k3s-userdata-* buckets only",
        "SSM parameters scoped to /k3s/* prefix only",
        "Secrets Manager scoped to k3s-*-* secrets only",
        "Regional services restricted to ap-southeast-1 via aws:RequestedRegion condition",
        "iam:PassRole restricted to EC2 and Lambda services only (prevents privilege escalation)"
      ]
    },
    "least_privilege_notes": [
      "EC2 permissions use wildcard resources (*) because instance ARNs are not known at launch time",
      "SSM GetCommandInvocation requires wildcard resources due to AWS API design",
      "CloudWatch metrics use wildcard resources for custom namespace publishing",
      "DynamoDB permissions are scoped to specific table ARNs with resource-level permissions",
      "S3 permissions are scoped to specific bucket prefix for bootstrap scripts",
      "IAM PassRole is scoped to specific worker role ARN (security best practice)",
      "Secrets Manager permissions use wildcard in account/region but scoped to secret name prefix (k3s-*)",
      "Deployment user (k3s-temp-user) has scoped administrative access with multiple boundaries: resource prefix scoping (k3s-*) and regional restriction (ap-southeast-1 only)"
    ],
    "security_considerations": [
      "SSH access (port 22) is open to 0.0.0.0/0 - should be restricted to specific IP ranges in production",
      "EC2 Describe* and CreateTags permissions use * resources - acceptable for EC2 service design",
      "K3s join token stored in Secrets Manager with automatic rotation recommended",
      "Lambda functions run in VPC with private subnets - no direct internet access required",
      "All IAM roles use assume role policies for specific services (lambda.amazonaws.com, ec2.amazonaws.com)",
      "Distributed locking via DynamoDB conditional writes prevents concurrent scaling operations",
      "Spot instance interruption handled via EventBridge rules with 2-minute warning",
      "Dead-letter queues (SQS) capture failed EventBridge events for debugging",
      "CloudWatch alarms configured for scaling failures, lock timeouts, and provisioning issues",
      "Deployment user (k3s-temp-user) has iam:PassRole restricted to EC2 and Lambda services only, preventing privilege escalation via PassRole to other services",
      "Deployment user permissions are scoped to k3s-* prefixed resources only, preventing unauthorized access to non-K3s AWS resources"
    ]
  },
  "iam_entities_summary": {
    "roles": {
      "lambda_execution_role": "k3s-autoscaler-lambda-role (shared by Decision, Scale-Up, Scale-Down, Cleanup Lambdas)",
      "worker_node_role": "k3s-worker-node-role (for worker EC2 instances)",
      "master_node_role": "k3s-master-node-role (for master EC2 instance)"
    },
    "users": {
      "deployment_temp_user": "k3s-temp-user (for Pulumi infrastructure deployment)"
    },
    "managed_policies": {
