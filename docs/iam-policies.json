      ]
    }
  },
  "compliance_mapping": {
    "cis_controls": {
      "controlled_access": "IAM roles with least privilege, no access keys for Lambda/EC2",
      "logging": "CloudWatch Logs enabled for all components, audit trail via CloudTrail",
