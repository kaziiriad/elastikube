# Ansible Inventory Template for K3s Autoscaler Production
# This file is automatically generated by deploy-k3s.sh
# Do not edit manually - use deploy-k3s.sh to regenerate

# SSH ProxyJump configuration for accessing private subnet via bastion
[all:vars]
ansible_ssh_common_args='-o ProxyJump=ubuntu@__BASTION_IP__ -o StrictHostKeyChecking=no'
ansible_python_interpreter=/usr/bin/python3

[master]
master-node ansible_host=__MASTER_IP__ ansible_user=ubuntu ansible_ssh_private_key_file=__KEY_FILE__

[workers]
worker-node-1 ansible_host=__WORKER_1_IP__ ansible_user=ubuntu ansible_ssh_private_key_file=__KEY_FILE__
worker-node-2 ansible_host=__WORKER_2_IP__ ansible_user=ubuntu ansible_ssh_private_key_file=__KEY_FILE__

[k3s_cluster:children]
master
workers

[all:vars]
s3_bucket_name=__S3_BUCKET__
aws_region=ap-southeast-1
