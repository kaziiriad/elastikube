#!/bin/bash
# K3s Worker Node Bootstrap Script (Pre-baked AMI version)
# SSM Agent, awscli, curl, jq, k3s binary all pre-installed in AMI
# Only joins cluster and tags instance

set -e

CLUSTER_NAME="{{ cluster_name }}"
AWS_REGION="{{ aws_region }}"
SECRET_NAME="k3s-${CLUSTER_NAME}-join-token"
SSM_MASTER_IP="/k3s/${CLUSTER_NAME}/master-ip"

echo "=== K3s Worker Node Bootstrap (Pre-baked AMI) ==="
echo "Cluster: $CLUSTER_NAME"
echo "Region: $AWS_REGION"

# Get instance metadata from IMDSv2
echo "[1/5] Getting instance metadata..."
TOKEN=$(curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds:21600" -s)
INSTANCE_ID=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id -s)
LOCAL_IP=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 -s)
AZ=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone -s)
echo "  Instance: $INSTANCE_ID"
echo "  IP: $LOCAL_IP"
echo "  AZ: $AZ"

# Get master IP from SSM Parameter Store
echo "[2/5] Fetching master IP from SSM Parameter..."
MAX_RETRIES=5
RETRY_COUNT=0

while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    MASTER_IP=$(
        aws ssm get-parameter \
            --name "$SSM_MASTER_IP" \
            --region "$AWS_REGION" \
            --query "Parameter.Value" \
            --output text 2>&1
    )

    if [ $? -eq 0 ] && [ -n "$MASTER_IP" ]; then
        echo "  Master IP: $MASTER_IP"
        break
    fi

    RETRY_COUNT=$((RETRY_COUNT + 1))
    echo "  Retry $RETRY_COUNT/$MAX_RETRIES: Failed to get master IP"
    sleep 5
done

if [ -z "$MASTER_IP" ]; then
    echo "ERROR: Failed to get master IP from SSM after $MAX_RETRIES attempts"
    exit 1
fi

# Get K3s join token from Secrets Manager
echo "[3/5] Fetching K3s join token from Secrets Manager..."
RETRY_COUNT=0

while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    JOIN_TOKEN=$(
        aws secretsmanager get-secret-value \
            --secret-id "$SECRET_NAME" \
            --region "$AWS_REGION" \
            --query "SecretString" \
            --output text 2>&1
    )

    if [ $? -eq 0 ] && [ -n "$JOIN_TOKEN" ]; then
        echo "  Token retrieved: ${JOIN_TOKEN:0:20}..."
        break
    fi

    RETRY_COUNT=$((RETRY_COUNT + 1))
    echo "  Retry $RETRY_COUNT/$MAX_RETRIES: Failed to get join token"
    sleep 5
done

if [ -z "$JOIN_TOKEN" ]; then
    echo "ERROR: Failed to get join token from Secrets Manager after $MAX_RETRIES attempts"
    exit 1
fi

# Detect primary network interface (ens5 on ENA, eth0 on virtio)
PRIMARY_IFACE=$(ip route show default | awk '{print $5}' | head -1)
if [ -z "$PRIMARY_IFACE" ]; then
    PRIMARY_IFACE="ens5"
fi
echo "  Primary interface: $PRIMARY_IFACE"

# Start k3s agent (binary pre-installed in AMI - skip download)
echo "[4/5] Starting k3s agent (pre-installed binary)..."

# Safety: stop any k3s server/agent that auto-started from AMI
echo "  Stopping any auto-started k3s services..."
systemctl stop k3s 2>/dev/null || true
systemctl stop k3s-agent 2>/dev/null || true
systemctl disable k3s 2>/dev/null || true
systemctl disable k3s-agent 2>/dev/null || true
pkill -9 -f "k3s" 2>/dev/null || true
sleep 2

# Verify binary exists and is executable
if [ ! -f /usr/local/bin/k3s ]; then
    echo "ERROR: k3s binary not found at /usr/local/bin/k3s"
    exit 1
fi
if [ ! -x /usr/local/bin/k3s ]; then
    echo "Making k3s binary executable..."
    chmod +x /usr/local/bin/k3s
fi

# Test master connectivity
echo "Testing connectivity to master $MASTER_IP:6443..."
if curl -sf --connect-timeout 5 "https://$MASTER_IP:6443" > /dev/null 2>&1; then
    echo "  Master API is reachable"
else
    echo "  WARNING: Cannot reach master API - will retry"
fi

# Start k3s agent directly (bypass systemd for faster bootstrap)
echo "Starting k3s-agent..."
nohup /usr/local/bin/k3s agent \
    --token="$JOIN_TOKEN" \
    --server="https://$MASTER_IP:6443" \
    --node-ip="$LOCAL_IP" \
    --node-name="ip-$LOCAL_IP" \
    --flannel-iface="$PRIMARY_IFACE" \
    >> /var/log/k3s-agent.log 2>&1 &

K3S_PID=$!
echo "  k3s-agent started with PID: $K3S_PID"

# Wait for K3s agent to start and join cluster
echo "  Waiting for K3s agent to start (max 120s)..."
WAIT_COUNT=0
MAX_WAIT=120
while [ $WAIT_COUNT -lt $MAX_WAIT ]; do
    # Check if k3s-agent process is running
    if pgrep -f "k3s agent" > /dev/null 2>&1; then
        echo "  k3s-agent process is running"
        break
    fi
    WAIT_COUNT=$((WAIT_COUNT + 5))
    echo "  Waiting... ${WAIT_COUNT}s / ${MAX_WAIT}s"
    sleep 5
done

# Verify agent joined cluster by checking kubectl
echo "  Verifying cluster join..."
sleep 5

# Check if k3s-agent process is still running
if pgrep -f "k3s agent" > /dev/null 2>&1; then
    echo "[5/5] Tagging instance..."

    # Tag the instance with cluster metadata
    aws ec2 create-tags \
        --resources "$INSTANCE_ID" \
        --tags \
            "Key=Cluster,Value=$CLUSTER_NAME" \
            "Key=NodeRole,Value=worker" \
            "Key=JoinStatus,Value=success" \
            "Key=JoinedAt,Value=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --region "$AWS_REGION" 2>/dev/null || true

    echo "=== Bootstrap Complete ==="
    echo "Worker node successfully joined cluster '$CLUSTER_NAME'!"
else
    echo "ERROR: k3s-agent process not running"
    echo "Checking logs:"
    tail -30 /var/log/k3s-agent.log 2>/dev/null || echo "  No log file found"

    # Tag as failed
    aws ec2 create-tags \
        --resources "$INSTANCE_ID" \
        --tags \
            "Key=Cluster,Value=$CLUSTER_NAME" \
            "Key=NodeRole,Value=worker" \
            "Key=JoinStatus,Value=failed" \
            "Key=FailedAt,Value=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --region "$AWS_REGION" 2>/dev/null || true
    exit 1
fi